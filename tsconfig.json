{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".desktop/next/types/**/*.ts",
    ".desktop/next/dev/types/**/*.ts",
    ".desktop/dev/types/**/*.ts",
    ".desktop/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "demo",
    ".local",
    ".desktop",
    "dist-desktop"
  ]
}
